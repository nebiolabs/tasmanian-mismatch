**/.DS_Store
*pyc
/dist/
/*.egg-info
*.swp
*table
*metrics
*summary
*bam
!tests/fixtures/*.bam
target*
test_output/*
# pixi environments
.pixi/*
!.pixi/config.toml

# Benchmark history is per machine (benches/history/<machine>.csv).  The chart
# in the readmen is generated by the CI so a local run should not clobber it.
benches/history/time-*.svg
!benches/history/time-ci-*.svg
